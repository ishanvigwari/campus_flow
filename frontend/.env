# ==========================================
# Backend API Configuration
# ==========================================
# Note: Do NOT add /api suffix - it's automatically appended by the frontend
VITE_API_URL=http://localhost:8080

# ==========================================
# Google OAuth Configuration (Optional)
# ==========================================
# To get your Client ID, follow the instructions in OAUTH_SETUP.md
# For now, Google login button will be disabled without valid client ID
# You can still use email/password login with demo credentials
VITE_GOOGLE_CLIENT_ID=disabled

